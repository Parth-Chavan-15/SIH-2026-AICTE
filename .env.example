# PravahReg / AICTE CaseFlow Environment Configuration

# Server Port (Default: 3001)
PORT=3001

# Vite / Express Environment
NODE_ENV=development

# Optional: MongoDB Connection URI
# When omitted, the built-in Companion In-Memory WORM Engine runs with 5 canonical college cases
# MONGODB_URI=mongodb://localhost:27017/sih2026_aicte

# Session & JWT Configuration
JWT_SECRET=sih-2026-aicte-pravahreg-super-secure-jwt-secret-key-32chars
SESSION_SECRET=sih-2026-companion-layer-session-secret-key

# Client Origin (CORS & SameSite origin validation)
CLIENT_ORIGIN=http://localhost:3001
